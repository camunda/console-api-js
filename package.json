{
  "name": "@camunda8/console-api",
  "version": "0.0.0-development",
  "description": "TypeScript client for the Camunda 8 SaaS Console (Administration) API",
  "private": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "author": "josh.wulf@camunda.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camunda/console-api-js.git"
  },
  "keywords": [
    "camunda",
    "camunda8",
    "console",
    "saas",
    "administration-api"
  ],
  "scripts": {
    "spec:fetch": "tsx scripts/fetch-spec.ts",
    "spec:check": "tsx scripts/fetch-spec.ts --check",
    "generate": "rimraf src/gen && openapi-ts",
    "build": "npm run generate && npm run sync-readme:check && npm run typecheck && npm run lint && tsup src/index.ts --dts --format esm,cjs --sourcemap --clean --out-dir dist",
    "test": "vitest run",
    "test:integration": "CONSOLE_API_INTEGRATION=1 vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "sync-readme": "tsx scripts/sync-readme-snippets.ts",
    "sync-readme:check": "tsx scripts/sync-readme-snippets.ts --check"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@camunda8/sdk-infra": "^1.7.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
