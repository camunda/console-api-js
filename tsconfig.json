{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@camunda8/console-api": ["./src/index.ts"] }
  },
  "include": [
    "examples",
    "src",
    "scripts",
    "tests",
    "tests-integration",
    "openapi-ts.config.ts",
    "vitest.config.ts",
    "tsup.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
